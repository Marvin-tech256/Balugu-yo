{
    "version": 2,
    "rootDirectory": "frontend-react",
    "buildCommand": "npm install && npm run build",
    "outputDirectory": "dist",
    "installCommand": "echo 'skip'",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
